{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app888",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "cf96876c-a2bf-4b66-9ca6-b817b5156829","database_name": "web-app888" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0608f67389f34f67bc2ad0e4fbf5c303" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
